# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# ─── AUTH (NestJS API) ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-to-a-secure-random-string-min-64-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-secure-random-string-min-64-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── MFA ──────────────────────────────────────────────────────────────────────
MFA_APP_NAME="Audit Platform Savicol"
MFA_ISSUER="Savicol"

# ─── FRONTEND ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Audit Platform Savicol"

# ─── DEPLOY (Vercel + Railway) ────────────────────────────────────────────────
# VERCEL_URL — set automatically by Vercel
# RAILWAY_STATIC_URL — set automatically by Railway
