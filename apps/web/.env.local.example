# Web · Audit Platform Savicol — Variables de entorno
# Copia este archivo a .env.local y completa los valores

# URL del API backend
# Dev local: http://localhost:4000
# Producción: https://tu-api.up.railway.app
NEXT_PUBLIC_API_URL="http://localhost:4000"

NEXT_PUBLIC_APP_NAME="Audit Platform"
NEXT_PUBLIC_APP_COMPANY="Savicol"

# Modo demo: true para cargar datos de prueba, false en producción
NEXT_PUBLIC_DEMO_MODE="false"
