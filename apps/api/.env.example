# API · Audit Platform Savicol — Variables de entorno
# Copia este archivo a .env y completa los valores

# Base de datos
# Dev SQLite:  file:./dev.db
# Prod Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# JWT secrets (generar con: openssl rand -base64 32)
JWT_ACCESS_SECRET="REEMPLAZAR_CON_SECRET_FUERTE_DE_32_CHARS"
JWT_REFRESH_SECRET="REEMPLAZAR_CON_SECRET_DIFERENTE_DE_32"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ADMIN inicial (creado por prisma seed)
ADMIN_EMAIL="admin@savicol.com"
ADMIN_PASSWORD="REEMPLAZAR_EN_PRODUCCION"
ADMIN_NAME="Administrador Savicol"

# CORS / Cookies
WEB_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# Servidor
PORT=4000
NODE_ENV="development"

# Seed de datos demo (true en dev, false en producción)
SEED_DEMO_DATA="true"
